{
  "openapi": "3.0.3",
  "info": { "title": "Mobile Order API", "version": "0.1.0" },
  "paths": {
    "/menu": {
      "get": {
        "x-owner": "UA",
        "summary": "メニュー一覧(売り切れ含む)",
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/MenuItem" } } } } } }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "x-owner": "UA",
        "summary": "注文作成(status は必ず PLACED)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
        "responses": {
          "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "description": "売り切れ商品を含む(UA の本実装で追加)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "x-owner": "UA",
        "summary": "注文照会",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/kitchen/orders": {
      "get": {
        "x-owner": "UB",
        "summary": "注文一覧(古い順)",
        "parameters": [{ "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/OrderStatus" } }],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object", "required": ["orders"], "properties": { "orders": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } } }
          }
        }
      }
    },
    "/kitchen/orders/{id}/status": {
      "patch": {
        "x-owner": "UB",
        "summary": "ステータスを1段階進める(transitionOrder 経由)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "$ref": "#/components/schemas/OrderStatus" } } } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "description": "不正な遷移", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/manager/menu": {
      "post": {
        "x-owner": "UC",
        "summary": "メニュー追加",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemInput" } } } },
        "responses": { "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } } }
      }
    },
    "/manager/menu/{id}": {
      "put": {
        "x-owner": "UC",
        "summary": "メニュー編集(価格変更を含む)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemInput" } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/manager/menu/{id}/availability": {
      "patch": {
        "x-owner": "UC",
        "summary": "売り切れ ON/OFF",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["is_available"], "properties": { "is_available": { "type": "boolean" } } } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/manager/sales/daily": {
      "get": {
        "x-owner": "UC",
        "summary": "日次売上(READY の注文のみ、completed_at の日付で集計)",
        "parameters": [{ "name": "date", "in": "query", "required": false, "schema": { "type": "string", "format": "date" } }],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailySales" } } } } }
      }
    }
  },
  "components": {
    "responses": {
      "Error": { "description": "error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "OrderStatus": { "type": "string", "enum": ["PLACED", "COOKING", "READY"] },
      "MenuItem": {
        "type": "object",
        "required": ["id", "name", "category", "price", "is_available"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "is_available": { "type": "boolean" }
        }
      },
      "MenuItemInput": {
        "type": "object",
        "required": ["name", "category", "price"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "is_available": { "type": "boolean" }
        }
      },
      "OrderLine": {
        "type": "object",
        "required": ["menu_item_id", "name", "unit_price", "qty"],
        "properties": {
          "menu_item_id": { "type": "integer" },
          "name": { "type": "string" },
          "unit_price": { "type": "integer" },
          "qty": { "type": "integer", "minimum": 1 }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "call_number", "status", "total", "created_at", "completed_at", "lines"],
        "properties": {
          "id": { "type": "integer" },
          "call_number": { "type": "integer" },
          "status": { "$ref": "#/components/schemas/OrderStatus" },
          "total": { "type": "integer" },
          "created_at": { "type": "string" },
          "completed_at": { "type": "string", "nullable": true },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/OrderLine" } }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["lines"],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "required": ["menu_item_id", "qty"], "properties": { "menu_item_id": { "type": "integer" }, "qty": { "type": "integer", "minimum": 1 } } }
          }
        }
      },
      "DailySales": {
        "type": "object",
        "required": ["date", "order_count", "total", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "order_count": { "type": "integer" },
          "total": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["menu_item_id", "name", "qty", "amount"],
              "properties": { "menu_item_id": { "type": "integer" }, "name": { "type": "string" }, "qty": { "type": "integer" }, "amount": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
