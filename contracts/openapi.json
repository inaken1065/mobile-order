{
  "openapi": "3.0.3",
  "info": { "title": "Mobile Order API", "version": "0.1.0" },
  "paths": {
    "/menu": {
      "get": {
        "x-owner": "UA",
        "x-read-by": ["UC"],
        "summary": "メニュー一覧(売り切れ含む)",
        "description": "売り切れ(is_available=false)を含む全件を返す。この契約には UC(店長 UI)が読み取りで依存しているため、UA は絞り込み・除外を行ってはならない(契約テスト 1c)。変更する場合は B0 に差し戻す。",
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/MenuItem" } } } } } }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "x-owner": "UA",
        "summary": "注文作成(status は必ず PLACED)",
        "description": "同一 menu_item_id の重複行は1行に合算する(qty に上限なし)。売り切れ判定・採番・INSERT は同一トランザクションで行い、400 / 409 のときは orders / order_lines に何も残らない。call_number は当日(JST)内で MAX+1(日次リセット)。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
        "responses": {
          "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "lines が空・不正、qty が1以上の整数でない、未知の menu_item_id", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "売り切れ商品を含む", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "x-owner": "UA",
        "summary": "注文照会",
        "description": "id が整数でない場合も 404 を返す。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/kitchen/orders": {
      "get": {
        "x-owner": "UB",
        "summary": "注文一覧(古い順)",
        "parameters": [{ "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/OrderStatus" } }],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object", "required": ["orders"], "properties": { "orders": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } } }
          },
          "400": { "description": "status が不正(PLACED / COOKING / READY 以外)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/kitchen/orders/{id}/status": {
      "patch": {
        "x-owner": "UB",
        "summary": "ステータスを1段階進める(transitionOrder 経由)",
        "description": "PLACED→COOKING→READY の隣接遷移のみ。completed_at は READY への遷移と同時にのみ設定される。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "$ref": "#/components/schemas/OrderStatus" } } } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "status の欠落・不正値・型違い、ボディなし(存在しない id より先に評価する)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "注文が存在しない、または id が整数でない", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "逆戻り・飛ばし・同一状態への遷移(DB は変わらない)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/manager/menu": {
      "post": {
        "x-owner": "UC",
        "summary": "メニュー追加",
        "description": "name / category は trim 後に非空、price は 0 以上の整数、is_available は boolean。省略時は販売中。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemInput" } } } },
        "responses": {
          "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } },
          "400": { "description": "name / category が空、price が 0 以上の整数でない、is_available が boolean でない、ボディ不正", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/manager/menu/{id}": {
      "put": {
        "x-owner": "UC",
        "summary": "メニュー編集(価格変更を含む)",
        "description": "is_available を省略した場合は現在値を維持する(価格変更だけで売り切れを解除しない)。id が整数でない場合も 404。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItemInput" } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } },
          "400": { "description": "POST /manager/menu と同じ入力検証", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/manager/menu/{id}/availability": {
      "patch": {
        "x-owner": "UC",
        "summary": "売り切れ ON/OFF",
        "description": "id が整数でない場合も 404。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["is_available"], "properties": { "is_available": { "type": "boolean" } } } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuItem" } } } },
          "400": { "description": "is_available の欠落、または boolean でない", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/manager/sales/daily": {
      "get": {
        "x-owner": "UC",
        "summary": "日次売上(READY の注文のみ、completed_at の日付で集計)",
        "description": "数量・金額は order_lines のスナップショット(注文時点の unit_price)で集計する。date 省略時は今日(JST)。",
        "parameters": [{ "name": "date", "in": "query", "required": false, "schema": { "type": "string", "format": "date" } }],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailySales" } } } },
          "400": { "description": "date の形式が不正、または存在しない日付(例: 2026-02-30)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": { "description": "error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "OrderStatus": { "type": "string", "enum": ["PLACED", "COOKING", "READY"] },
      "MenuItem": {
        "type": "object",
        "required": ["id", "name", "category", "price", "is_available"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "is_available": { "type": "boolean" }
        }
      },
      "MenuItemInput": {
        "type": "object",
        "required": ["name", "category", "price"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "is_available": { "type": "boolean" }
        }
      },
      "OrderLine": {
        "type": "object",
        "required": ["menu_item_id", "name", "unit_price", "qty"],
        "properties": {
          "menu_item_id": { "type": "integer" },
          "name": { "type": "string" },
          "unit_price": { "type": "integer" },
          "qty": { "type": "integer", "minimum": 1 }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "call_number", "status", "total", "created_at", "completed_at", "lines"],
        "properties": {
          "id": { "type": "integer" },
          "call_number": { "type": "integer" },
          "status": { "$ref": "#/components/schemas/OrderStatus" },
          "total": { "type": "integer" },
          "created_at": { "type": "string" },
          "completed_at": { "type": "string", "nullable": true },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/OrderLine" } }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["lines"],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "required": ["menu_item_id", "qty"], "properties": { "menu_item_id": { "type": "integer" }, "qty": { "type": "integer", "minimum": 1 } } }
          }
        }
      },
      "DailySales": {
        "type": "object",
        "required": ["date", "order_count", "total", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "order_count": { "type": "integer" },
          "total": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["menu_item_id", "name", "qty", "amount"],
              "properties": { "menu_item_id": { "type": "integer" }, "name": { "type": "string" }, "qty": { "type": "integer" }, "amount": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
