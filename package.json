{
  "name": "mobile-order",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "db:reset": "tsx server/src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test:contracts": "node --import tsx --test \"contracts/test/*.test.ts\"",
    "test:units": "node --import tsx --test \"server/test/*/*.test.ts\"",
    "test:web": "node --import tsx --test \"web/test/*.test.ts\"",
    "test": "npm run test:contracts && npm run test:units && npm run test:web",
    "mutation:check": "tsx scripts/mutation-check.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
